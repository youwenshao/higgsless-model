[Unit]
Description=ComfyUI for higgsless
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@COMFY_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=HF_HOME=@DATA_ROOT@/_hf
# Inputs and outputs both live in the data root, so workflows read and write project files in place.
ExecStart=@COMFY_ROOT@/.venv/bin/python main.py --listen @BIND_ADDR@ --port @PORT@ \
  --input-directory @DATA_ROOT@ --output-directory @DATA_ROOT@ \
  --preview-method none --disable-auto-launch @EXTRA_ARGS@
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
